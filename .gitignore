# Git ignore rules for MOVEIT

# ==========================
# SECURITY: Environment files
# These contain Supabase credentials and must NEVER be committed to version control
# ==========================
.env
.env.local
.env.production
.env.*.local

# Keep the example template for reference (contains no real credentials)
!.env.example

# Build output
dist/
dist-ssr/

# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor/OS artifacts
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Vite cache
.vite/
